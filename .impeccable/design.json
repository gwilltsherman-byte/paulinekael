    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Film search with an explicit accessible name.",
      "html": "<input class=\"ds-search\" type=\"search\" aria-label=\"Search films\" placeholder=\"Search for a film, like Heat or Amélie\">",
      "css": ".ds-search{width:100%;min-height:56px;padding:15px 18px;background:var(--surface,#f9fafb);color:var(--text,#142e43);border:1px solid var(--line-2,#a8bac7);border-radius:5px;font:16px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;appearance:none;caret-color:var(--ink,#102c43)}.ds-search::placeholder{color:var(--muted,#526574);opacity:1}.ds-search:focus-visible{outline:3px solid #337ab0;outline-offset:4px;border-radius:3px;} @media(prefers-reduced-motion:reduce){.ds-search{transition:none!important;animation:none!important;scroll-behavior:auto!important}}"

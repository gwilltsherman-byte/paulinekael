      "html": "<button class=\"ds-button-primary\">Save to watchlist</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:5px;font:600 14px/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer;transition:background .16s,color .16s,opacity .16s;background:var(--ink,#102c43);color:#fff;border:0}.ds-button-primary:hover{background:#234d6a}.ds-button-primary:focus-visible{outline:3px solid #337ab0;outline-offset:4px;border-radius:3px;}.ds-button-primary:active:not(:disabled){opacity:.78}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;animation:none!important;scroll-behavior:auto!important}}"
